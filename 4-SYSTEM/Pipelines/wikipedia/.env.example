# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# `config.load_settings()` reads this file from the repo root; a real environment
# variable of the same name always wins over it.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Tibetan Wikipedia. Create a bot password at:
#   https://bo.wikipedia.org/wiki/Special:BotPasswords
# The username is of the form "YourAccount@botname" and the password is the
# generated string — NOT your main account password.
WIKI_SITE=bo.wikipedia.org
WIKI_USERNAME=
WIKI_BOT_PASSWORD=

# Safety: anything that writes to Wikipedia is dry-run unless this is explicitly false.
# Leave as true. The publish command requires an explicit --execute flag regardless.
KWIKI_DRY_RUN=true
