# Obsidian workspace state (per-machine, not shared)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Plugin data files (per-machine credentials / state)
.obsidian/plugins/obsidian-git/data.json
.obsidian/plugins/gemini-scribe/data.json

# System junk
.trash/
.DS_Store

# Claude Code worktrees (local only)
.claude/worktrees/

# Wikipedia pipeline (4-SYSTEM/Pipelines/wikipedia)
4-SYSTEM/Pipelines/*/.venv/
4-SYSTEM/Pipelines/*/.env
4-SYSTEM/Pipelines/*/corpora/
__pycache__/
*.pyc
*.egg-info/
