   },
   {
    "key": "goddess",
    "rank": 98,
    "score": 0.221674,
    "count": 1,
    "bo": "ལྷ་མོ",
    "term": "goddess",
    "en": "goddess",
    "grade": "general",
    "zh": "天女"
   }
  ]
 },
 "2-2": {
  "text": "Having arisen at dusk and at dawn,\nWill be granted complete fearlessness through recollection;\nAll misdeeds will be thoroughly pacified,\nAnd all lower realms will be utterly destroyed.",
  "bo_text": "སྲོད་དང་ཐོ་རངས་ལངས་པར་བྱས་ནས། ། དྲན་པས་མི་འཇིགས་ཐམས་ཅད་རབ་སྟེར། ། སྡིག་པ་ཐམས་ཅད་རབ་ཏུ་ཞི་བ། ། ངན་འགྲོ་ཐམས་ཅད་འཇོམས་པ་ཉིད་དོ། །",
  "zh_text": "",
  "keywords": []
 },
 "2-3": {
  "text": "Seventy million Victorious Ones\nWill swiftly confer empowerment,\nAnd one will attain even greater excellence than this,\nProceeding to that ultimate state of Buddhahood.",
  "bo_text": "རྒྱལ་བ་བྱེ་བ་ཕྲག་བདུན་རྣམས་ཀྱིས། ། མྱུར་དུ་དབང་ནི་བསྐུར་བར་འགྱུར་ལ། ། འདི་ལས་ཆེ་བ་ཉིད་ནི་འཐོབ་ཅིང་། ། སངས་རྒྱས་གོ་འཕང་མཐར་ཐུག་དེར་འགྲོ། །",
  "zh_text": "",
  "keywords": [
   {
    "key": "great",
    "rank": 69,
    "score": 0.163859,
    "count": 1,
    "bo": "ཆེ་བ",
    "term": "greater",
    "en": "greater",
    "grade": "general",
    "zh": "更殊勝"
   },
   {
    "key": "power",
    "rank": 85,
    "score": 0.202539,
    "count": 1,
    "bo": "དབང",
    "term": "empowerment",
    "en": "empowerment",
    "grade": "general",
    "zh": "灌頂"
   }
  ]
 },
 "2-4": {
  "text": "Their poisons, which are extremely fierce,\nWhether stationary or moving,\nEven those that have been eaten or drunk,\nAre completely eliminated through recollection.",
  "bo_text": "དེ་ཡི་དུག་ནི་དྲག་པོ་ཆེན་པོ། ། བརྟན་གནས་པའམ་གཞན་ཡང་འགྲོ་བ། ། ཟོས་པ་དང་ནི་འཐུངས་པ་ཉིད་ཀྱང་། ། དྲན་པས་རབ་ཏུ་སེལ་བ་ཉིད་ཐོབ། །",
  "zh_text": "",
  "keywords": []
 },
 "2-5": {
  "text": "For those tormented by demons, infectious diseases, and poisons,\nThe masses of suffering are utterly cast off;\nThis applies to other sentient beings as well.",
  "bo_text": "གདོན་དང་རིམས་དང་དུག་གིས་གཟིར་བའི། ། སྡུག་བསྔལ་ཚོགས་ནི་རྣམ་པར་སྤོང་སྟེ། ། སེམས་ཅན་གཞན་པ་རྣམས་ལ་ཡང་ངོ་། །",
  "zh_text": "",
