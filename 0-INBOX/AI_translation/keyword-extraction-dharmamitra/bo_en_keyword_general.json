  "2-2": {
    "text": "Having arisen at dusk or at dawn, Will be granted complete fearlessness through recollection. All misdeeds will be thoroughly pacified, And all lower realms will be destroyed;",
    "bo_text": "སྲོད་དང་ཐོ་རངས་ལངས་པར་བྱས་ནས། ། དྲན་པས་མི་འཇིགས་ཐམས་ཅད་རབ་སྟེར། ། སྡིག་པ་ཐམས་ཅད་རབ་ཏུ་ཞི་བ། ། ངན་འགྲོ་ཐམས་ཅད་འཇོམས་པ་ཉིད་དོ། །",
    "en_text": "",
    "keywords": []
  },
  "2-3": {
    "text": "Seventy million Victorious Ones Will swiftly confer empowerment. One will attain even greater significance than this, And proceed to that ultimate state of buddhahood.",
    "bo_text": "རྒྱལ་བ་བྱེ་བ་ཕྲག་བདུན་རྣམས་ཀྱིས། ། མྱུར་དུ་དབང་ནི་བསྐུར་བར་འགྱུར་ལ། ། འདི་ལས་ཆེ་བ་ཉིད་ནི་འཐོབ་ཅིང་། ། སངས་རྒྱས་གོ་འཕང་མཐར་ཐུག་དེར་འགྲོ། །",
    "en_text": "",
    "keywords": [
